# Server
PORT=5001
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/brain_tumor_detection

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI Service (mock for now, will point to FastAPI later)
AI_SERVICE_URL=http://localhost:8000

# Temporary: secret key for bootstrapping doctor/admin accounts before the real Admin Module exists. Remove this once admins can create staff accounts through the UI.
SETUP_KEY=your_setup_key_here

# CORS - allowed frontend origin
CLIENT_URL=http://localhost:5173
